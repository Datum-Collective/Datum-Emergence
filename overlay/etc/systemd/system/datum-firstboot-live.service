[Unit]
Description=Datum Emergence live first-boot user setup
# Takes over tty1 from getty so the setup prompt owns the visible VT, then
# hands it to greetd (which also conflicts with getty@tty1 itself).
# vconsole-setup first so the font/keymap are settled before we paint the TUI;
# systemd.show_status=no (kernel cmdline via livecd/bootargs) keeps boot status
# off this VT so the form is never mixed with [ OK ] lines (Failure A).
After=getty@tty1.service systemd-vconsole-setup.service
Conflicts=getty@tty1.service
# Documents intent; greetd is not enabled in the live image, firstboot starts
# it imperatively once a valid account exists.
Before=greetd.service

[Service]
Type=oneshot
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStart=/usr/local/bin/datum-firstboot-live

[Install]
WantedBy=multi-user.target
