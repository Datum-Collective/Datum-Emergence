#!/bin/sh
# datum-boot-probe: one-shot live/installed boot self-check.
#
# Records what actually came up: systemd state, services, the installer (on
# live media), the greetd/Hyprland session (on installed systems), and Datum
# branding. Results go to the journal, /dev/kmsg, /dev/ttyS0 (captured by
# hypervisors with a serial console), and /run/datum-boot-probe.result.
# Always exits 0; it reports, it never fails the boot.
#
# Non-blocking by design: nothing orders any other unit After this one, its
# stdout is null (service unit), the quiet kernel cmdline suppresses systemd
# status display, and TimeoutStartSec bounds the polls. It must never own,
# block, or paint the user-facing VT (installer on live, tuigreet on
# installed).
set -eu

RESULT=/run/datum-boot-probe.result
SERIAL=/dev/ttyS0

emit() {
  printf 'DATUM_PROBE %s\n' "$*" >> "$RESULT"
  printf 'DATUM_PROBE %s\n' "$*" > /dev/kmsg 2>/dev/null || true
  printf 'DATUM_PROBE %s\n' "$*" > "$SERIAL" 2>/dev/null || true
  logger -t datum-boot-probe -- "$*" 2>/dev/null || true
}

: > "$RESULT" 2>/dev/null || RESULT=/tmp/datum-boot-probe.result
: > "$RESULT" 2>/dev/null || exit 0

emit "begin $(date -u +%FT%TZ) $(cat /proc/cmdline 2>/dev/null)"

# System state. On live media the product is the installer; on installed
# systems it is the greeter/desktop. Neither is ordered after this probe.
if command -v systemctl >/dev/null 2>&1; then
  emit "system=$(systemctl is-system-running 2>/dev/null || echo unknown)"
  for svc in NetworkManager.service greetd.service datum-installer.service; do
    if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
      emit "service.$svc=$(systemctl is-active $svc 2>/dev/null || echo unknown)"
    fi
  done
fi

# Live media detection.
if test -e /dev/disk/by-label/DATUM_EMERGENCE_AMD64; then
  emit "live-media=present"
else
  emit "live-media=absent(installed?)"
fi

# Session detection. The live ISO is an installer environment: no one ever
# logs in there, so no session is expected (the installer owns tty1). On
# installed systems, detect the human user (uid >= 1000) that logged in
# through tuigreet. Never hardcode a username.
SESSION_USER=""
if test -e /dev/disk/by-label/DATUM_EMERGENCE_AMD64; then
  emit "installer.expected=active(no login session on live media)"
  emit "user.session=no(live-installer)"
else
  # Installed system: the permanent user logs in through tuigreet, but
  # session registration takes seconds; poll instead of racing it.
  for i in $(seq 1 30); do
    for u in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
      uid=$(id -u "$u" 2>/dev/null || echo 0)
      if test "$uid" -ge 1000 2>/dev/null; then
        if loginctl show-user "$u" >/dev/null 2>&1; then
          SESSION_USER=$u
          break 2
        fi
      fi
    done
    sleep 2
  done
fi
if test -n "$SESSION_USER"; then
  emit "user.session=yes($SESSION_USER)"
elif test -e /dev/disk/by-label/DATUM_EMERGENCE_AMD64; then
  : # already reported above; keep live output stable
else
  emit "user.session=no"
fi

HYPRLAND=no
WAYLAND_SOCK=no
APPS_SEEN=""
if test -n "$SESSION_USER"; then
  # Poll: the compositor and its exec-once apps can take seconds to appear
  # after the session registers. A single check races startup.
  for i in $(seq 1 12); do
    if pgrep -u "$SESSION_USER" -x Hyprland >/dev/null 2>&1; then
      HYPRLAND=yes
    fi
    # Any UID's runtime dir (installed UIDs differ per setup).
    for rtdir in /run/user/*; do
      for sock in "$rtdir"/wayland-* "$rtdir"/hypr/*/.hyprland.sock "$rtdir"/hypr/*/hyprland.sock; do
        if test -S "$sock" 2>/dev/null || test -e "$sock" 2>/dev/null; then
          WAYLAND_SOCK="$sock"
          break 2
        fi
      done
    done
    if test "$HYPRLAND" = yes && test "$WAYLAND_SOCK" != no; then
      break
    fi
    sleep 5
  done
fi
emit "user.session.hyprland=$HYPRLAND"
emit "user.session.wayland-socket=$WAYLAND_SOCK"
# Compositor helpers: give exec-once apps an extra settle window after the
# socket appears before recording their final state, so autostart lag is not
# misreported as a broken desktop.
if test -n "$SESSION_USER"; then
  for i in $(seq 1 12); do
    ALL_UP=yes
    for app in hyprpaper waybar dunst; do
      if ! pgrep -u "$SESSION_USER" -x "$app" >/dev/null 2>&1; then
        ALL_UP=no
        break
      fi
    done
    if test "$ALL_UP" = yes; then break; fi
    sleep 5
  done
  for app in hyprpaper waybar dunst wofi kitty Hyprland; do
    if pgrep -u "$SESSION_USER" -x "$app" >/dev/null 2>&1; then
      emit "user.session.app.$app=running"
    else
      emit "user.session.app.$app=absent"
    fi
  done
fi
# Ask the compositor about outputs (this also proves hyprctl can talk to it).
# Runs as root with the session's runtime dir + instance signature: root
# bypasses the socket permissions, so no per-user sudo rule is needed
# (none ships on the image; passwordless sudo to the user never worked).
if test -n "$SESSION_USER"; then
  SUID=$(id -u "$SESSION_USER" 2>/dev/null || echo "")
  if test -n "$SUID"; then
    for HDIR in /run/user/"$SUID"/hypr/*; do
      test -d "$HDIR" || continue
      SIG=$(basename "$HDIR")
      MONS=$(env "HYPRLAND_INSTANCE_SIGNATURE=$SIG" "XDG_RUNTIME_DIR=/run/user/$SUID" hyprctl monitors 2>&1 | grep -E '^Monitor' | tr '\n' ';' | cut -c1-200)
      emit "hyprland.monitors=$MONS"
    done
  fi
fi
if command -v journalctl >/dev/null 2>&1; then
  journalctl --no-pager _COMM=hyprpaper 2>/dev/null | tail -n 8 | while IFS= read -r line; do
    emit "hyprpaper.log: $(printf '%s' "$line" | cut -c1-200)"
  done
fi
if command -v journalctl >/dev/null 2>&1; then
  # Exclude our own logger lines, which would otherwise drown real errors.
  journalctl --no-pager -p warning --grep='hyprpaper|hyprland|wallpaper|greetd|tuigreet' 2>/dev/null | grep -v 'DATUM_PROBE' | head -n 10 | while IFS= read -r line; do
    emit "journal.err: $(printf '%s' "$line" | cut -c1-200)"
  done
fi
# DRM/GPU inventory: Hyprland 0.56 requires a DRM device; a system with no
# /dev/dri entries cannot start the compositor (software fallback is not
# provided by this backend). Recording this here distinguishes a broken
# session stack from an unsupported virtual GPU without guessing.
if test -d /dev/dri; then
  emit "gpu.dri=$(ls /dev/dri 2>/dev/null | tr '\n' ',' || echo unknown)"
else
  emit "gpu.dri=absent(no DRM devices; Hyprland cannot start here)"
fi

# Branding / identity.
for f in /usr/share/backgrounds/datum-emergence/wallpaper.png /etc/emergence/release /etc/hostname; do
  if test -e "$f"; then
    emit "file.$f=present"
  else
    emit "file.$f=MISSING"
  fi
done
if test -e /etc/hostname; then
  emit "hostname=$(cat /etc/hostname 2>/dev/null)"
fi

# Live/installed state separation. The live ISO carries /etc/datum/live; the
# installer removes it from the target and writes /etc/datum/installed
# instead. A healthy installed boot therefore has the installed marker, no
# live marker, and a real human session.
if test -e /dev/disk/by-label/DATUM_EMERGENCE_AMD64; then
  emit "installer.fstab-root=live-iso"
  if test -e /etc/datum/live; then
    emit "installer.live-marker=present"
  else
    emit "installer.live-marker=MISSING"
  fi
else
  if grep -Eq '^UUID=[^ ]+ +/ +ext4' /etc/fstab 2>/dev/null; then
    emit "installer.fstab-root=uuid-ok"
  else
    emit "installer.fstab-root=BAD"
  fi
  if grep -Eq '^UUID=[^ ]+ +/boot/efi +vfat' /etc/fstab 2>/dev/null; then
    emit "installer.fstab-efi=uuid-ok"
  else
    emit "installer.fstab-efi=BAD"
  fi
  if test -e /boot/efi/EFI/BOOT/BOOTX64.EFI; then
    emit "installer.removable-bootloader=present"
  else
    emit "installer.removable-bootloader=MISSING"
  fi
  if test -e /etc/datum/installed; then
    emit "installer.installed-marker=present"
  else
    emit "installer.installed-marker=MISSING"
  fi
  if test -e /etc/datum/live; then
    emit "installer.live-marker-removed=no(MARKER PRESENT)"
  else
    emit "installer.live-marker-removed=yes"
  fi
fi
# The account the current graphical session runs as, if any.
if command -v loginctl >/dev/null 2>&1; then
  emit "session.users=$(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}' | tr '\n' ',' || echo unknown)"
fi

emit end
exit 0
