#!/bin/sh
# datum-install: install the running Datum Emergence live system to a disk.
#
# The live ISO is an installer environment. With no arguments on a terminal
# this starts the guided installer (main menu, keyboard, account, hostname,
# timezone, summary, disk, confirmation, progress, success). With flags it
# runs non-interactively (automation/VM tests).
#
# Usage:
#   sudo datum-install                                   # guided installer
#   sudo datum-install --disk /dev/vdX [--keymap X] [--hostname NAME]
#                      [--user NAME] [--timezone ZONE] [--yes] [--reboot]
#
# The installer partitions the target with a GPT (512M EFI System Partition
# + root), copies the live system with tar, writes fstab, installs GRUB for
# UEFI (including the removable fallback), creates the permanent target user,
# configures the target (hostname, timezone, keyboard, quiet boot, greetd),
# strips all live-only state, and validates the target before declaring
# success. The target disk is fully overwritten.
#
# Password: asked twice with masked input in the guided flow, or taken from
# EMERGENCE_INSTALL_PASSWORD (automation only; never a default, never logged,
# never passed as a process argument, never written to the target).
set -eu

PROG=datum-install
MNT=/mnt/datum-target
ESP_SIZE_MIB=512
MIN_DISK_MIB=10240
LOG=/var/log/emergence-installer.log
TUI_MODE=no

info() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() {
  printf '%s: error: %s\n' "$PROG" "$*" >&2
  log "fatal: $*"
  # Failures must be visible on the serial console too: without this, an
  # engine failure wedges the TUI at a pause prompt with no marker at all.
  # die() messages never carry secrets (paths, stages, validation results).
  kmsg "fatal: $*"
  if test "$TUI_MODE" = yes && test -c /dev/tty; then
    printf '\n  Press Enter to return to the installer menu.\n' > /dev/tty
    IFS= read -r _dummy < /dev/tty || true
  fi
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "required tool not found in live image: $1"; }
# Detailed diagnostics go to the log file; the console stays a clean
# stage view. Passwords, hashes, and the chpasswd input are never
# written here: only stage names, timings, disk/filesystem operations,
# and validation results are logged.
log() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  printf '%s %s: %s\n' "$(date -u +%FT%TZ 2>/dev/null || echo '?')" "$PROG" "$*" >> "$LOG" 2>/dev/null || true
}
# Progress markers for the journal, kernel log, and serial console (captured
# by VM test harnesses). Values are limited to non-secret configuration
# (step names, keymap, username, hostname, timezone, disk); passwords and
# hashes are NEVER emitted here.
kmsg() {
  printf '%s\n' "Datum installer: $*" > /dev/kmsg 2>/dev/null || true
  printf '%s\n' "Datum installer: $*" > /dev/ttyS0 2>/dev/null || true
  logger -t datum-install -- "$*" 2>/dev/null || true
}
# Noisy engine commands: output to the log only, never onto the install UI.
runlog() {
  "$@" >>"$LOG" 2>&1 || die "command failed (see $LOG): $*"
}
STAGE_N=0
STAGE_TOTAL=8
stage() {
  STAGE_N=$((STAGE_N + 1))
  info "[$STAGE_N/$STAGE_TOTAL] $*"
  log "stage $STAGE_N/$STAGE_TOTAL: $*"
  # Stage markers on the serial console let test harnesses (and anyone
  # watching serial) localize a stall inside the long engine run. The
  # bracket markers "engine start"/"install success" alone leave a
  # fifteen-minute silence between them.
  kmsg "stage $STAGE_N/$STAGE_TOTAL: $*"
  if test "$TUI_MODE" = yes; then
    tui_say "  [$STAGE_N/$STAGE_TOTAL] $*"
  fi
}

usage() {
  cat >&2 <<EOF
usage: $PROG [--disk DEVICE] [--keymap MAP] [--hostname NAME] [--user NAME] [--timezone ZONE] [--yes] [--reboot]
  (no arguments on a terminal: guided installer)
  --disk      target block device (e.g. /dev/vda). ALL DATA ON IT IS DESTROYED.
  --keymap    console keymap (default: us)
  --hostname  installed hostname (default: emergence)
  --user      permanent target user (default: datum)
  --timezone  e.g. UTC, Europe/Berlin (default: UTC)
  --yes       confirm the destructive operation (also prints the plan first)
  --reboot    reboot when finished
EOF
  exit 2
}

DISK=""
KEYMAP=us
HOSTNAME=emergence
NEWUSER=datum
TIMEZONE=UTC
CONFIRM=no
REBOOT=no
GAVE_DISK=no
GAVE_KEYMAP=no
GAVE_USER=no
GAVE_HOST=no
GAVE_TZ=no

while test $# -gt 0; do
  case "$1" in
    --disk) DISK=${2:?--disk needs a value}; GAVE_DISK=yes; shift 2 ;;
    --keymap) KEYMAP=${2:?--keymap needs a value}; GAVE_KEYMAP=yes; shift 2 ;;
    --hostname) HOSTNAME=${2:?--hostname needs a value}; GAVE_HOST=yes; shift 2 ;;
    --user) NEWUSER=${2:?--user needs a value}; GAVE_USER=yes; shift 2 ;;
    --timezone) TIMEZONE=${2:?--timezone needs a value}; GAVE_TZ=yes; shift 2 ;;
    --yes) CONFIRM=yes; shift ;;
    --reboot) REBOOT=yes; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

# ---------------------------------------------------------------------------
# Guided installer TUI (pure POSIX sh, no extra dependencies).
# ---------------------------------------------------------------------------
tui_say() { printf '%s\n' "$*" > /dev/tty; }
tui_header() {
  printf '\033[H\033[2J' > /dev/tty 2>/dev/null || true
  tui_say ""
  tui_say "  +------------------------------------------------+"
  tui_say "  |                DATUM  EMERGENCE                |"
  tui_say "  |                  Install system                |"
  tui_say "  +------------------------------------------------+"
  tui_say ""
}
tui_err() { tui_say ""; tui_say "  ! $1"; tui_say "  Please try again."; tui_say ""; }
tui_ask() {
  # $1 = prompt, $2 = default (optional). Echoes answer on stdout.
  # ${2-} (not $2): several callers pass no default, and under `set -u` an
  # unset $2 aborts the prompt instead of returning empty.
  _p=$1; _d=${2-}
  if test -n "$_d"; then printf '%s [%s]: ' "$_p" "$_d" > /dev/tty;
  else printf '%s: ' "$_p" > /dev/tty; fi
  IFS= read -r _a < /dev/tty || _a=""
  if test -z "$_a"; then printf '%s' "$_d"; else printf '%s' "$_a"; fi
}
tui_ask_hidden() {
  # $1 = prompt. Echoes answer on stdout, input masked.
  _p=$1
  printf '%s: ' "$_p" > /dev/tty
  stty -echo < /dev/tty 2>/dev/null || true
  IFS= read -r _a < /dev/tty || _a=""
  stty echo < /dev/tty 2>/dev/null || true
  printf '\n' > /dev/tty
  printf '%s' "$_a"
}
tui_pause() {
  printf '%s' "$1 [Enter] " > /dev/tty
  IFS= read -r _dummy < /dev/tty || true
}
valid_tui_user() {
  case "$1" in ""|root|emergence|greeter|greetd|*[^a-z0-9_-]*|-[a-z0-9_-]*|[0-9]*) return 1;; esac
  return 0
}
keymaps_available() {
  test -d /usr/share/keymaps && command -v loadkeys >/dev/null 2>&1
}
list_keymaps() {
  # available console keymap names (bare names as loadkeys expects them),
  # one per line, sorted.
  find /usr/share/keymaps -name '*.map.gz' 2>/dev/null \
    | sed -e 's#.*/##' -e 's#\.map\.gz$##' | sort -u
}
valid_keymap() {
  list_keymaps | grep -qx "$1"
}
# Live-media detection for disk exclusion. $1 = whole-disk path (e.g.
# /dev/vda). Returns 0 when the running live image lives on that disk.
# Three independent signals: optical/rom drives are never targets, known
# live mount points are traced back to their disk, and the engine additionally
# refuses the booted source (see run_engine).
is_live_disk() {
  _d=$1
  if test "$(lsblk -dn -o TYPE "$_d" 2>/dev/null)" = rom; then
    return 0
  fi
  for _cand in /mnt/cdrom /run/live /run/archiso/bootmnt /run/initramfs/live; do
    _src=$(findmnt -n -o SOURCE "$_cand" 2>/dev/null) || continue
    test -n "$_src" || continue
    case "$_src" in
      "$_d"*) return 0 ;;
    esac
    if lsblk -ln -o PATH "$_d" 2>/dev/null | grep -qx "$_src"; then
      return 0
    fi
  done
  return 1
}
keymap_to_xkb() {
  # Console keymap -> Hyprland kb_layout. Console and XKB names mostly agree;
  # handle the known divergences, default to us.
  case "$1" in
    uk) printf 'gb' ;;
    us|gb|de|fr|es|it|pt|br|ru|se|no|dk|fi|pl|cz|sk|hu|ro|tr|gr|il|jp) printf '%s' "$1" ;;
    *) printf 'us' ;;
  esac
}

tui_welcome() {
  kmsg "welcome"
  tui_header
  tui_say "  Welcome to Datum Emergence."
  tui_say ""
  tui_say "  This installer deploys the Emergence system from this"
  tui_say "  ISO onto a disk of your choice. The target disk is fully"
  tui_say "  overwritten: you will confirm explicitly before anything"
  tui_say "  is destroyed."
  tui_say ""
}

tui_keyboard() {
  if ! keymaps_available; then
    KEYMAP=us
    kmsg "keyboard unavailable, default us"
    return 0
  fi
  while true; do
    tui_header
    tui_say "  Step 1/7: keyboard"
    tui_say ""
    tui_say "  Available keymaps (default us):"
    tui_say ""
    list_keymaps | head -n 40 | sed 's/^/    /' > /dev/tty
    _total=$(list_keymaps | wc -l)
    if test "$_total" -gt 40; then
      tui_say "    ... ($_total total; type any listed name)"
    fi
    tui_say ""
    KEYMAP=$(tui_ask "  Keymap" "us")
    if valid_keymap "$KEYMAP"; then
      if loadkeys "$KEYMAP" < /dev/tty > /dev/tty 2>&1; then
        log "live keymap applied: $KEYMAP"
      else
        tui_err "Could not activate '$KEYMAP' right now; it will still be installed."
      fi
      break
    fi
    tui_err "Unknown keymap '$KEYMAP'."
    sleep 1
  done
}

tui_account() {
  while true; do
    tui_header
    tui_say "  Step 2/7: user account"
    tui_say ""
    tui_say "  This creates the permanent user of the installed system."
    tui_say ""
    NEWUSER=$(tui_ask "  Username" "datum")
    if ! valid_tui_user "$NEWUSER"; then
      kmsg "invalid username rejected: [$NEWUSER]"
      tui_err "Invalid username '$NEWUSER' (a-z, 0-9, _ and -; must not start with a digit or -; reserved names refused)."
      sleep 1
      continue
    fi
    while true; do
      _pw1=$(tui_ask_hidden "  Password")
      _pw2=$(tui_ask_hidden "  Confirm password")
      if test -z "$_pw1"; then tui_err "Empty password rejected."; continue; fi
      if test "$_pw1" != "$_pw2"; then kmsg "password mismatch"; tui_err "Passwords do not match."; continue; fi
      EMERGENCE_INSTALL_PASSWORD_TUI=$_pw1
      break
    done
    break
  done
}

tui_hostname() {
  while true; do
    tui_header
    tui_say "  Step 3/7: hostname"
    HOSTNAME=$(tui_ask "  Hostname" "emergence")
    case "$HOSTNAME" in *[!a-zA-Z0-9-]*|"")
      kmsg "invalid hostname rejected"; tui_err "Invalid hostname."; sleep 1; continue ;;
    esac
    break
  done
}

tui_timezone() {
  while true; do
    tui_header
    tui_say "  Step 4/7: timezone"
    tui_say "  Examples: UTC, Europe/Berlin, Asia/Kolkata"
    TIMEZONE=$(tui_ask "  Timezone" "UTC")
    if ! test -f "/usr/share/zoneinfo/$TIMEZONE"; then
      kmsg "unknown timezone rejected"; tui_err "Unknown timezone '$TIMEZONE'."; sleep 1; continue
    fi
    break
  done
}

tui_summary() {
  kmsg "summary"
  while true; do
    tui_header
    tui_say "  Step 5/7: summary"
    tui_say ""
    tui_say "  Keyboard:  $KEYMAP"
    tui_say "  Username:  $NEWUSER"
    tui_say "  Hostname:  $HOSTNAME"
    tui_say "  Timezone:  $TIMEZONE"
    tui_say "  Mode:      Full disk"
    tui_say ""
    _yn=$(tui_ask "  Continue, or go Back to change settings [Continue/back]")
    case "$_yn" in
      [Bb]*) kmsg "summary back"; return 1 ;;
      *) return 0 ;;
    esac
  done
}

tui_disk() {
  while true; do
    tui_header
    tui_say "  Step 6/7: installation disk"
    tui_say "  ALL DATA on the chosen disk will be destroyed."
    tui_say ""
    _i=0; _list=""
    for _d in $(lsblk -dn -o PATH 2>/dev/null); do
      _bytes=$(lsblk -bn -o SIZE -d "$_d" 2>/dev/null || echo 0)
      _mib=$((_bytes / 1048576))
      if test "$_mib" -lt "$MIN_DISK_MIB"; then continue; fi
      if is_live_disk "$_d"; then continue; fi
      _i=$((_i + 1))
      _model=$(lsblk -dn -o MODEL "$_d" 2>/dev/null | sed 's/^ *//;s/ *$//')
      _size=$(lsblk -dn -o SIZE "$_d" 2>/dev/null | sed 's/^ *//')
      kmsg "disk candidate [${_i}]: $_d $_size $_model"
      tui_say "  [${_i}] $_d  $_size  $_model"
      lsblk -ln -o PATH,SIZE,FSTYPE,LABEL "$_d" 2>/dev/null | tail -n +2 | sed 's/^/        /' > /dev/tty || true
      _list="$_list $_d"
    done
    if test "$_i" -eq 0; then
      tui_err "No suitable disk found (need >= ${MIN_DISK_MIB}MiB, live media hidden)."
      die "no suitable installation disk"
    fi
    tui_say ""
    _pick=$(tui_ask "  Choose disk [1-$_i]")
    case "$_pick" in ''|*[!0-9]*)
      # Log the rejected value (length + hex): a systematic mismatch here
      # means the prompt is receiving something other than what was typed.
      kmsg "disk choice invalid: [$_pick] len=${#_pick} hex=$(printf '%s' "$_pick" | od -An -tx1 2>/dev/null | tr -d ' \n')"
      tui_err "Enter a number 1-$_i."; sleep 1; continue ;;
    esac
    if test "$_pick" -lt 1 -o "$_pick" -gt "$_i" 2>/dev/null; then kmsg "disk choice out of range"; tui_err "Out of range."; sleep 1; continue; fi
    _n=0; for _d in $_list; do _n=$((_n + 1)); if test "$_n" = "$_pick"; then DISK=$_d; fi; done
    kmsg "disk chosen: $DISK"
    break
  done
}

tui_confirm() {
  while true; do
    tui_header
    _dmib=$(($(lsblk -bn -o SIZE -d "$DISK" 2>/dev/null || echo 0) / 1048576))
    _model=$(lsblk -dn -o MODEL "$DISK" 2>/dev/null | sed 's/^ *//;s/ *$//')
    tui_say "  Step 7/7: confirm"
    tui_say ""
    tui_say "  WARNING: everything on this disk will be destroyed."
    tui_say ""
    tui_say "  Disk:      $DISK  (${_dmib}MiB  $_model)"
    tui_say "  Username:  $NEWUSER"
    tui_say "  Hostname:  $HOSTNAME"
    tui_say "  Timezone:  $TIMEZONE"
    tui_say "  Keyboard:  $KEYMAP"
    tui_say ""
    tui_say "  All existing partitions and data on $DISK"
    tui_say "  will be removed. This cannot be undone."
    tui_say ""
    _yn=$(tui_ask "  Type yes to erase and install [Cancel]")
    case "$_yn" in
      [Yy][Ee][Ss]|[Ii][Nn][Ss][Tt][Aa][Ll][Ll]) CONFIRM=yes; break ;;
    esac
    tui_say "  Installation cancelled; no changes were made."
    return 1
  done
  return 0
}

tui_install_flow() {
  tui_welcome
  tui_pause "  Press Enter to continue."
  while true; do
    kmsg "configure keyboard"
    tui_keyboard
    kmsg "configure account"
    tui_account
    kmsg "configure hostname"
    tui_hostname
    kmsg "configure timezone"
    tui_timezone
    if tui_summary; then break; fi
  done
  kmsg "configure disk"
  tui_disk
  kmsg "confirm (disk=$DISK user=$NEWUSER host=$HOSTNAME tz=$TIMEZONE keymap=$KEYMAP)"
  if ! tui_confirm; then
    kmsg "cancelled by user"
    EMERGENCE_INSTALL_PASSWORD_TUI=x; unset EMERGENCE_INSTALL_PASSWORD_TUI 2>/dev/null || true
    return 1
  fi
  if test -z "${EMERGENCE_INSTALL_PASSWORD:-}" && test -n "${EMERGENCE_INSTALL_PASSWORD_TUI:-}"; then
    EMERGENCE_INSTALL_PASSWORD=$EMERGENCE_INSTALL_PASSWORD_TUI
    export EMERGENCE_INSTALL_PASSWORD
    EMERGENCE_INSTALL_PASSWORD_TUI=x; unset EMERGENCE_INSTALL_PASSWORD_TUI
  fi
  tui_header
  tui_say "  Installing Emergence on $DISK ..."
  tui_say ""
  return 0
}

tui_success() {
  tui_header
  tui_say "  +------------------------------------------------+"
  tui_say "  |              Installation complete             |"
  tui_say "  +------------------------------------------------+"
  tui_say ""
  tui_say "  Installed on $DISK (user $NEWUSER, host $HOSTNAME)."
  tui_say "  Remove the installation ISO and boot from $DISK."
  tui_say ""
  _yn=$(tui_ask "  Reboot now [Yes/no]")
  case "$_yn" in [Nn]*) return 0 ;; *) reboot ;; esac
}

tui_menu() {
  while true; do
    kmsg "menu"
    tui_header
    tui_say "  What would you like to do?"
    tui_say ""
    tui_say "  [1] Install Emergence"
    tui_say "  [2] Shell (root, for inspection/repair)"
    tui_say "  [3] Reboot"
    tui_say "  [4] Power off"
    tui_say ""
    _c=$(tui_ask "  Choice [1-4]" "1")
    case "$_c" in
      1)
        if tui_install_flow; then
          run_engine
          # Scrub the installed password from this process: it served its
          # single chpasswd use and must not linger in the service environ.
          EMERGENCE_INSTALL_PASSWORD=x; unset EMERGENCE_INSTALL_PASSWORD 2>/dev/null || true
          tui_success
        fi
        ;;
      2)
        tui_say ""
        tui_say "  Starting a root shell. Type 'exit' to return here."
        ( exec /bin/bash < /dev/tty > /dev/tty 2>&1 ) || true
        ;;
      3) reboot ;;
      4) poweroff ;;
      *) tui_err "Enter 1-4."; sleep 1 ;;
    esac
  done
}

# Guided mode is dispatched at the bottom of this file, after run_engine is
# defined: with no --disk on a terminal the menu runs, otherwise the engine
# runs directly on the given flags. Automation always passes --disk and never
# lands in the menu.

# ---------------------------------------------------------------------------
# Installation engine (shared by guided and automated installs).
# ---------------------------------------------------------------------------
run_engine() {
test -n "$DISK" || usage
test "$(id -u)" -eq 0 || die "run as root (e.g. with sudo)"
kmsg "engine start (disk=$DISK user=$NEWUSER host=$HOSTNAME)"
need sfdisk; need mkfs.vfat; need mkfs.ext4; need blkid; need lsblk
need tar; need grub-install; need grub-mkconfig; need systemd-machine-id-setup
need useradd; need chpasswd; need passwd; need udevadm

# Validate names before touching the disk.
case "$HOSTNAME" in
  *[!a-zA-Z0-9-]*|"") die "invalid hostname: $HOSTNAME" ;;
esac
case "$NEWUSER" in
  ""|root|emergence|greeter|greetd|*[^a-z0-9_-]*|-[a-z0-9_-]*|[0-9]*) die "invalid username: $NEWUSER (must not be root/emergence/greeter/greetd)" ;;
esac
test -f "/usr/share/zoneinfo/$TIMEZONE" || die "unknown timezone: $TIMEZONE"
if test -n "$KEYMAP" && keymaps_available; then
  valid_keymap "$KEYMAP" || die "unknown keymap: $KEYMAP"
fi
test -b "$DISK" || die "not a block device: $DISK"

# Refuse targets that are obviously wrong.
if grep -Eq "^[^ ]+ $MNT( |/)" /proc/mounts; then
  die "$MNT is already in use; unmount a previous install first"
fi
for part in $(lsblk -ln -o PATH "$DISK" 2>/dev/null | tail -n +2); do
  if grep -Eq "^[^ ]+ $part " /proc/mounts || findmnt -n -o TARGET "$part" >/dev/null 2>&1; then
    test "$part" = "$DISK" && continue
    die "refusing: $part (on $DISK) is currently mounted"
  fi
done
# Refuse the device the live ISO itself booted from (best effort, plus the
# optical-drive rule which needs no mount topology to hold).
if is_live_disk "$DISK"; then
  die "refusing: $DISK provides the running live image"
fi
for cand in /mnt/cdrom /run/live /run/archiso/bootmnt /run/initramfs/live; do
  if findmnt -n -o SOURCE "$cand" >/dev/null 2>&1; then
    live_src=$(findmnt -n -o SOURCE "$cand")
    case "$live_src" in
      "$DISK"*) die "refusing: $DISK provides the running live image ($cand on $live_src)" ;;
    esac
  fi
done

DISK_MIB=$(($(lsblk -bn -o SIZE -d "$DISK") / 1048576))
test "$DISK_MIB" -ge "$MIN_DISK_MIB" || die "$DISK is only ${DISK_MIB}MiB (need >= ${MIN_DISK_MIB}MiB)"

log "install started: disk=$DISK size_mib=$DISK_MIB keymap=$KEYMAP hostname=$HOSTNAME user=$NEWUSER timezone=$TIMEZONE"
info "plan:"
info "  disk:     $DISK (${DISK_MIB}MiB) -- ALL DATA WILL BE DESTROYED"
info "  layout:   GPT: p1 ${ESP_SIZE_MIB}MiB ESP (FAT32), p2 rest root (ext4)"
info "  keymap:   $KEYMAP"
info "  hostname: $HOSTNAME"
info "  user:     $NEWUSER (target-only account)"
info "  timezone: $TIMEZONE"
info "  boot:     GRUB x86_64-efi (NVRAM entry + removable fallback)"
info "  log:      $LOG (detailed diagnostics; never contains passwords)"
lsblk "$DISK" >&2 || true
log "disk layout shown; waiting for explicit confirmation"
test "$CONFIRM" = yes || die "re-run with --yes to confirm destruction of $DISK"

# Password for the new user.
if test -n "${EMERGENCE_INSTALL_PASSWORD:-}"; then
  info "using password from EMERGENCE_INSTALL_PASSWORD"
  NEW_PASSWORD=$EMERGENCE_INSTALL_PASSWORD
else
  test -c /dev/tty || die "no terminal for password prompt; set EMERGENCE_INSTALL_PASSWORD"
  stty -echo < /dev/tty
  trap 'stty echo < /dev/tty' EXIT INT TERM
  printf 'password for %s: ' "$NEWUSER" > /dev/tty
  IFS= read -r NEW_PASSWORD < /dev/tty
  printf '\nrepeat password: ' > /dev/tty
  IFS= read -r NEW_PASSWORD2 < /dev/tty
  stty echo < /dev/tty
  trap - EXIT INT TERM
  printf '\n' > /dev/tty
  test -n "$NEW_PASSWORD" || die "empty password refused"
  test "$NEW_PASSWORD" = "$NEW_PASSWORD2" || die "passwords do not match"
fi

# Partition (sectors throughout: the only unit every sfdisk accepts; 2048 =
# 1MiB alignment, 1048576 sectors = 512MiB ESP). Types are full GPT GUIDs:
# sfdisk 2.42 rejects MBR codes like 83 on GPT labels.
stage "Preparing disk $DISK (GPT, 512MiB ESP + root)"
log "partitioning $DISK"
runlog sfdisk --wipe always "$DISK" <<EOF
label: gpt
unit: sectors
start=2048, size=1048576, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
start=1050624, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4
EOF
# Wait for partition nodes with or without a running udev daemon (the
# installer also runs from minimal shells where udevadm has no daemon).
runlog partx -u "$DISK" >>"$LOG" 2>&1 || true
udevadm settle 2>/dev/null || sleep 2
ESP=${DISK}1
ROOTP=${DISK}2
case "$DISK" in
  *[0-9]) ESP=${DISK}p1; ROOTP=${DISK}p2 ;; # /dev/nvme0n1, /dev/mmcblk0, ...
esac
for i in $(seq 1 15); do
  test -b "$ESP" && test -b "$ROOTP" && break
  partx -u "$DISK" 2>/dev/null || true
  sleep 2
done
test -b "$ESP" || die "EFI partition did not appear: $ESP"
test -b "$ROOTP" || die "root partition did not appear: $ROOTP"
log "partitions ready: ESP=$ESP ROOT=$ROOTP"

stage "Formatting filesystems (FAT32 ESP, ext4 root)"
runlog mkfs.vfat -F 32 -n DATUM_EFI "$ESP"
runlog mkfs.ext4 -q -L datum-root -F "$ROOTP"
log "filesystems created"

stage "Installing Emergence (copying live system)"
info "mounting target ..."
cleanup() {
  umount -R "$MNT" 2>/dev/null || true
}
trap 'cleanup' EXIT INT TERM
mkdir -p "$MNT"
mount "$ROOTP" "$MNT"
mkdir -p "$MNT/boot/efi"
mount "$ESP" "$MNT/boot/efi"

info "copying live system (this takes a few minutes) ..."
log "copy started"
# NOTE: no --xattrs/--acls. The live overlayfs does not support listing
# xattrs, so those flags only produce thousands of failing syscalls (and, in
# a VM without a serial reader, enough warning spam to stall the copy on
# backpressure). Modes, ownership and timestamps are preserved; the image
# carries no file capabilities that would be lost (setuid bits are modes).
tar -C / --one-file-system \
  --exclude=./dev/* --exclude=./proc/* --exclude=./sys/* \
  --exclude=./tmp/* --exclude=./run/* --exclude=./mnt/* --exclude=./media/* \
  --exclude=./lost+found \
  -cf - . 2>>"$LOG" | tar -C "$MNT" -xpf - 2>>"$LOG" \
  || die "system copy failed (see $LOG)"
mkdir -p "$MNT/dev" "$MNT/proc" "$MNT/sys" "$MNT/run" "$MNT/tmp" "$MNT/mnt" "$MNT/media"
chmod 1777 "$MNT/tmp"

# fstab by UUID.
ROOT_UUID=$(blkid -s UUID -o value "$ROOTP")
ESP_UUID=$(blkid -s UUID -o value "$ESP")
cat > "$MNT/etc/fstab" <<EOF
# Datum Emergence installed system (written by $PROG).
UUID=$ROOT_UUID  /          ext4  defaults           0 1
UUID=$ESP_UUID   /boot/efi  vfat  defaults           0 2
tmpfs            /tmp       tmpfs nodev,nosuid       0 0
EOF

# Chroot scaffolding for target configuration.
mount --bind /dev "$MNT/dev"
mount --bind /dev/pts "$MNT/dev/pts"
mount -t proc none "$MNT/proc"
mount --bind /sys "$MNT/sys"
mount --bind /run "$MNT/run"
# Best-effort: absent on minimal boots (e.g. init=/bin/sh without
# NetworkManager); nothing during installation needs name resolution.
cp -f /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null || true

target() { chroot "$MNT" /bin/sh -c "$1"; }

stage "Configuring system (hostname, timezone, keyboard, machine identity)"
log "copy finished; writing fstab and host identity"
info "configuring installed system ..."
printf '%s\n' "$HOSTNAME" > "$MNT/etc/hostname"
cat > "$MNT/etc/hosts" <<EOF
127.0.0.1  localhost
::1        localhost
127.0.1.1  $HOSTNAME.localdomain $HOSTNAME
EOF
# Fresh machine identity (never carry the live session's over).
rm -f "$MNT/etc/machine-id" "$MNT/var/lib/dbus/machine-id"
runlog target "systemd-machine-id-setup"
log "machine-id regenerated"
# Console keyboard persists on the target; the graphical layout follows
# below when it differs from us.
if test -n "$KEYMAP"; then
  printf 'KEYMAP=%s\n' "$KEYMAP" > "$MNT/etc/vconsole.conf"
  log "target keymap: $KEYMAP"
fi

stage "Creating user $NEWUSER (target-only account)"
# The live ISO never creates any user: there is no live account to inherit,
# adopt, or clean up. The image ships no UID >= 1000 accounts, so any such
# entry on the target (other than the requested user) is unexpected state:
# refuse to guess instead of silently inheriting it. (65534/nobody is not a
# human account.)
STRAY_USERS=$(awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' "$MNT/etc/passwd" 2>/dev/null || true)
for stray in $STRAY_USERS; do
  if test "$stray" != "$NEWUSER"; then
    die "unexpected UID>=1000 account '$stray' on target; refusing to inherit it"
  fi
done
for g in wheel users audio video render input plugdev; do
  runlog target "getent group $g >/dev/null || groupadd -r $g"
done
if target "id $NEWUSER >/dev/null 2>&1"; then
  die "account '$NEWUSER' already exists on the target; refusing to reuse it"
fi
runlog target "useradd -m -s /bin/bash -G wheel,users,audio,video,render,input,plugdev $NEWUSER"
printf '%s:%s\n' "$NEWUSER" "$NEW_PASSWORD" | runlog target "chpasswd"
NEW_PASSWORD=x; unset NEW_PASSWORD
log "target user password set (value never logged)"
runlog target "passwd -l root || true"
# Graphical keyboard layout follows the console keymap when it diverges
# from us (the rice default). Both the new user's config and /etc/skel
# (for any later users) are updated; nothing else in the rice is touched.
XKB=$(keymap_to_xkb "$KEYMAP")
if test "$XKB" != us; then
  for cfg in "$MNT/home/$NEWUSER/.config/hypr/hyprland.lua" "$MNT/etc/skel/.config/hypr/hyprland.lua"; do
    if test -f "$cfg"; then
      sed -i 's/kb_layout = "us"/kb_layout = "'"$XKB"'"/' "$cfg"
      log "kb_layout set to $XKB in target $cfg"
    fi
  done
fi
runlog target "chown -R $NEWUSER:users /home/$NEWUSER"
# Timezone.
ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$MNT/etc/localtime"
log "timezone set to $TIMEZONE"

stage "Installing bootloader (GRUB UEFI + removable fallback)"
# Bootloader. The dist-kernel + dracut initramfs are already in /boot from the
# live image; just (re)install GRUB and generate the config on the target.
# The removable fallback (BOOTX64.EFI) is mandatory: it is what boots on
# firmware without a registered entry (many VMs, some boards). The NVRAM
# entry is best-effort so installs also succeed where efivars is unavailable.
test -e "$MNT"/boot/vmlinuz-* || die "no kernel in target /boot; refusing to leave an unbootable system"
runlog target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck"
if ! target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=datum --recheck" >>"$LOG" 2>&1; then
  info "NVRAM boot entry could not be registered; removable fallback installed"
fi
# The installed system boots like the live ISO: quiet, no status spam on the
# login VT (greetd owns it). Diagnostics remain in the journal.
if test -f "$MNT/etc/default/grub"; then
  if grep -q '^GRUB_CMDLINE_LINUX=' "$MNT/etc/default/grub"; then
    sed -i 's/^GRUB_CMDLINE_LINUX=.*/GRUB_CMDLINE_LINUX="quiet loglevel=3 systemd.show_status=no rd.systemd.show_status=no udev.log_level=3"/' "$MNT/etc/default/grub"
  else
    printf '%s\n' 'GRUB_CMDLINE_LINUX="quiet loglevel=3 systemd.show_status=no rd.systemd.show_status=no udev.log_level=3"' >> "$MNT/etc/default/grub"
  fi
else
  printf '%s\n' 'GRUB_CMDLINE_LINUX="quiet loglevel=3 systemd.show_status=no rd.systemd.show_status=no udev.log_level=3"' > "$MNT/etc/default/grub"
fi
runlog target "grub-mkconfig -o /boot/grub/grub.cfg"
# grub-mkconfig falls back to unstable device names (root=/dev/...) when it
# cannot resolve UUIDs (no udev, unusual topologies). Device names shift
# across boots (USB media added/removed), so enforce the UUID root that the
# installer already wrote to fstab.
if grep -Eq "^[[:space:]]*linux[[:space:]]" "$MNT/boot/grub/grub.cfg"; then
  sed -i -E '/^[[:space:]]*linux[[:space:]]/ s#root=[^ ]+#root=UUID='"$ROOT_UUID"'#' "$MNT/boot/grub/grub.cfg"
  grep -Eq "root=UUID=$ROOT_UUID" "$MNT/boot/grub/grub.cfg" || die "could not enforce UUID root in grub.cfg"
fi

# Installed system keeps the intended services (symlinks were copied over,
# but re-enable to be certain they resolve on the target). The live
# installer must never run on the target: disable its unit and remove the
# installer machinery outright (disabling alone would leave live-only files
# behind). The installed login is always tuigreet + real PAM
# authentication: no initial_session autologin is ever configured.
stage "Configuring desktop session (greetd, NetworkManager, live-state cleanup)"
runlog target "systemctl enable NetworkManager.service greetd.service"
if grep -q '^\[initial_session\]' "$MNT/etc/greetd/config.toml"; then
  die "unexpected initial_session in target greetd config"
fi
if ! grep -q '^\[default_session\]' "$MNT/etc/greetd/config.toml"; then
  die "target greetd config has no default (tuigreet) session"
fi
runlog target "systemctl disable datum-installer.service"
rm -f "$MNT/etc/systemd/system/datum-installer.service" \
  "$MNT/usr/local/bin/datum-install"
# Live/install separation markers: the live ISO carries /etc/datum/live;
# the target carries /etc/datum/installed instead. A lingering live marker
# on the target means live identity leaked into the installation.
rm -f "$MNT/etc/datum/live" "$MNT/etc/datum/live-user"
mkdir -p "$MNT/etc/datum"
printf 'installed\n' > "$MNT/etc/datum/installed"

stage "Validating installation (target self-check before reboot)"
validate_target() {
  # $1 = mountpoint. Fails loudly instead of declaring success on a
  # half-written target. Mirrors the automated host-side checks in
  # scripts/test-install.sh so manual installs get the same guarantees.
  t=$1
  vfail=0
  vcheck() {
    desc=$1; shift
    if "$@" >/dev/null 2>&1; then
      log "target check PASS: $desc"
    else
      info "target check FAIL: $desc"
      log "target check FAIL: $desc"
      vfail=1
    fi
  }
  vcheck "target root exists" test -d "$t/etc"
  vcheck "EFI partition mounted" test -d "$t/boot/efi"
  vcheck "fstab UUID root" grep -Eq '^UUID=[^ ]+ +/ +ext4' "$t/etc/fstab"
  vcheck "fstab UUID ESP" grep -Eq '^UUID=[^ ]+ +/boot/efi +vfat' "$t/etc/fstab"
  vcheck "root UUID matches fstab" grep -q "UUID=$ROOT_UUID" "$t/etc/fstab"
  vcheck "ESP UUID matches fstab" grep -q "UUID=$ESP_UUID" "$t/etc/fstab"
  vcheck "machine-id present" test -s "$t/etc/machine-id"
  vcheck "hostname correct" grep -qx "$HOSTNAME" "$t/etc/hostname"
  vcheck "timezone link" test -L "$t/etc/localtime"
  vcheck "vconsole keymap" grep -qx "KEYMAP=$KEYMAP" "$t/etc/vconsole.conf"
  vcheck "quiet boot configured" grep -q 'systemd.show_status=no' "$t/etc/default/grub"
  vcheck "kernel present" ls "$t"/boot/vmlinuz-*
  vcheck "GRUB config present" test -f "$t/boot/grub/grub.cfg"
  vcheck "GRUB UUID root" grep -Eq "root=UUID=$ROOT_UUID" "$t/boot/grub/grub.cfg"
  vcheck "removable bootloader" test -f "$t/boot/efi/EFI/BOOT/BOOTX64.EFI"
  vcheck "greetd config present" test -f "$t/etc/greetd/config.toml"
  vcheck "tuigreet default session" grep -q '^\[default_session\]' "$t/etc/greetd/config.toml"
  vcheck "no initial_session autologin" test -z "$(grep '^\[initial_session\]' "$t/etc/greetd/config.toml" || true)"
  vcheck "target user exists" grep -q "^$NEWUSER:" "$t/etc/passwd"
  vcheck "target home exists" test -d "$t/home/$NEWUSER"
  # Numeric UID comparison: names resolve against the RUNNING system's user
  # database (live ISO or test host), never the target's, so a name check
  # compares against the wrong namespace. UIDs are unambiguous.
  _want_uid=$(awk -F: -v u="$NEWUSER" '$1==u{print $3}' "$t/etc/passwd")
  vcheck "target home owned by user" test "$(stat -c %u "$t/home/$NEWUSER" 2>/dev/null)" = "$_want_uid"
  vcheck "desktop launcher present" test -x "$t/usr/local/bin/start-datum"
  vcheck "hyprland config present" test -f "$t/home/$NEWUSER/.config/hypr/hyprland.lua"
  vcheck "installed marker present" test -e "$t/etc/datum/installed"
  vcheck "live marker removed" test "!" -e "$t/etc/datum/live"
  vcheck "live installer unit removed" test "!" -e "$t/etc/systemd/system/datum-installer.service"
  vcheck "live installer binary removed" test "!" -e "$t/usr/local/bin/datum-install"
  if test "$vfail" -ne 0; then
    die "target validation failed; see $LOG. The disk was written but is NOT declared good."
  fi
  log "target validation passed"
}
validate_target "$MNT"
log "install finished: user=$NEWUSER host=$HOSTNAME disk=$DISK"
kmsg "install success (user=$NEWUSER host=$HOSTNAME disk=$DISK)"
# Leave a sanitized copy of the install log on the target for post-install
# diagnostics (it never contains passwords or hashes by construction).
mkdir -p "$MNT/var/log" 2>/dev/null || true
cp -f "$LOG" "$MNT/var/log/emergence-installer.log" 2>/dev/null || true

info "unmounting ..."
trap - EXIT INT TERM
umount -R "$MNT"
rmdir "$MNT" 2>/dev/null || true
info "installed Datum Emergence on $DISK (user $NEWUSER, host $HOSTNAME)."
info "remove the live ISO and boot from $DISK."
if test "$REBOOT" = yes; then
  info "rebooting ..."
  reboot
fi
} # end run_engine

# Dispatch: guided menu on an interactive terminal without flags, otherwise
# the engine on the given flags.
if test "$GAVE_DISK" = no && test -c /dev/tty; then
  TUI_MODE=yes
  export TUI_MODE
  tui_menu
  exit 0
fi

# Automated (flags) path: the TUI menu already ran the engine itself.
run_engine
