#!/bin/sh
# datum-install: install the running Datum Emergence live system to a disk.
#
# Usage:
#   sudo datum-install --disk /dev/vdX [--hostname NAME] [--user NAME]
#                      [--timezone ZONE] [--yes] [--reboot]
#
# The installer partitions the target with a GPT (512M EFI System Partition
# + root), copies the live system with tar, writes fstab, installs GRUB for
# UEFI (including the removable fallback), removes the live-only account the
# firstboot setup created (it was copied over with the filesystem), creates
# the permanent first local user, and removes live-only identity. The target
# disk is fully overwritten.
#
# Password: prompted twice on the terminal, or taken from
# EMERGENCE_INSTALL_PASSWORD (used by automated VM installs).
set -eu

PROG=datum-install
MNT=/mnt/datum-target
ESP_SIZE_MIB=512
MIN_DISK_MIB=10240
LOG=/var/log/emergence-installer.log

info() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "required tool not found in live image: $1"; }
# Detailed diagnostics go to the log file; the console stays a clean
# stage/spinner view. Passwords, hashes, and the chpasswd input are never
# written here: only stage names, timings, disk/filesystem operations,
# and validation results are logged.
log() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  printf '%s %s: %s\n' "$(date -u +%FT%TZ 2>/dev/null || echo '?')" "$PROG" "$*" >> "$LOG" 2>/dev/null || true
}
STAGE_N=0
STAGE_TOTAL=8
stage() {
  STAGE_N=$((STAGE_N + 1))
  info "[$STAGE_N/$STAGE_TOTAL] $*"
  log "stage $STAGE_N/$STAGE_TOTAL: $*"
}

usage() {
  cat >&2 <<EOF
usage: $PROG --disk DEVICE [--hostname NAME] [--user NAME] [--timezone ZONE] [--yes] [--reboot]
  --disk      target block device (e.g. /dev/vda). ALL DATA ON IT IS DESTROYED.
  --hostname  installed hostname (default: emergence)
  --user      permanent first local user (default: datum)
  --timezone  e.g. UTC, Europe/Berlin (default: UTC)
  --yes       confirm the destructive operation (also prints the plan first)
  --reboot    reboot when finished

  With no arguments and a terminal attached, $PROG starts a guided
  installer (username, password, hostname, timezone, disk choice,
  destructive confirmation, staged progress). Flags remain the automation
  seam (tests, unattended installs via EMERGENCE_INSTALL_PASSWORD).
EOF
  exit 2
}

DISK=""
HOSTNAME=emergence
NEWUSER=datum
TIMEZONE=UTC
CONFIRM=no
REBOOT=no
GAVE_DISK=no
GAVE_USER=no
GAVE_HOST=no
GAVE_TZ=no

while test $# -gt 0; do
  case "$1" in
    --disk) DISK=${2:?--disk needs a value}; GAVE_DISK=yes; shift 2 ;;
    --hostname) HOSTNAME=${2:?--hostname needs a value}; GAVE_HOST=yes; shift 2 ;;
    --user) NEWUSER=${2:?--user needs a value}; GAVE_USER=yes; shift 2 ;;
    --timezone) TIMEZONE=${2:?--timezone needs a value}; GAVE_TZ=yes; shift 2 ;;
    --yes) CONFIRM=yes; shift ;;
    --reboot) REBOOT=yes; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

# Guided installer: no --disk on a terminal means the human wants the full
# Datum flow (account, hostname, timezone, disk, confirmation) instead of raw
# flags. Automation (tests, scripts) always passes --disk, so it never lands
# here. Pure POSIX sh, no dialog/whiptail dependency: clean screen, Datum
# branding, masked passwords, validation with reprompts, numbered disk menu
# that hides the live media, explicit destructive confirmation.
if test "$GAVE_DISK" = no && test -c /dev/tty; then
  tui_say() { printf '%s\n' "$*" > /dev/tty; }
  tui_header() {
    printf '\033[H\033[2J' > /dev/tty 2>/dev/null || true
    tui_say ""
    tui_say "  +------------------------------------------------+"
    tui_say "  |                DATUM  EMERGENCE                |"
    tui_say "  |                  Install system                |"
    tui_say "  +------------------------------------------------+"
    tui_say ""
  }
  tui_err() { tui_say ""; tui_say "  ! $1"; tui_say "  Please try again."; tui_say ""; }
  tui_ask() {
    # $1 = prompt, $2 = default. Echoes answer on stdout.
    _p=$1; _d=$2
    if test -n "$_d"; then printf '%s [%s]: ' "$_p" "$_d" > /dev/tty;
    else printf '%s: ' "$_p" > /dev/tty; fi
    IFS= read -r _a < /dev/tty || _a=""
    if test -z "$_a"; then printf '%s' "$_d"; else printf '%s' "$_a"; fi
  }
  tui_ask_hidden() {
    # $1 = prompt. Echoes answer on stdout, input masked.
    _p=$1
    printf '%s: ' "$_p" > /dev/tty
    stty -echo < /dev/tty 2>/dev/null || true
    IFS= read -r _a < /dev/tty || _a=""
    stty echo < /dev/tty 2>/dev/null || true
    printf '\n' > /dev/tty
    printf '%s' "$_a"
  }
  valid_tui_user() {
    case "$1" in ""|root|emergence|greeter|greetd|*[^a-z0-9_-]*|-[a-z0-9_-]*|[0-9]*) return 1;; esac
    return 0
  }
  # 1/5 account + hostname + timezone.
  while true; do
    tui_header
    tui_say "  Step 1/5: account"
    if test "$GAVE_USER" = no; then
      NEWUSER=$(tui_ask "  Username" "datum")
      if ! valid_tui_user "$NEWUSER"; then tui_err "Invalid username '$NEWUSER'."; sleep 1; continue; fi
    fi
    while true; do
      _pw1=$(tui_ask_hidden "  Password")
      _pw2=$(tui_ask_hidden "  Confirm password")
      if test -z "$_pw1"; then tui_err "Empty password rejected."; continue; fi
      if test "$_pw1" != "$_pw2"; then tui_err "Passwords do not match."; continue; fi
      EMERGENCE_INSTALL_PASSWORD_TUI=$_pw1
      break
    done
    break
  done
  if test "$GAVE_HOST" = no; then
    while true; do
      tui_header
      tui_say "  Step 2/5: hostname"
      HOSTNAME=$(tui_ask "  Hostname" "emergence")
      case "$HOSTNAME" in *[!a-zA-Z0-9-]*|"") tui_err "Invalid hostname."; sleep 1; continue;; esac
      break
    done
  fi
  if test "$GAVE_TZ" = no; then
    while true; do
      tui_header
      tui_say "  Step 3/5: timezone"
      tui_say "  Examples: UTC, Europe/Berlin, Asia/Kolkata"
      TIMEZONE=$(tui_ask "  Timezone" "UTC")
      if ! test -f "/usr/share/zoneinfo/$TIMEZONE"; then tui_err "Unknown timezone '$TIMEZONE'."; sleep 1; continue; fi
      break
    done
  fi
  # 4/5 disk: enumerate whole disks, hide live media + tiny devices.
  while true; do
    tui_header
    tui_say "  Step 4/5: installation disk"
    tui_say "  ALL DATA on the chosen disk will be destroyed."
    tui_say ""
    _i=0; _list=""
    for _d in $(lsblk -dn -o PATH 2>/dev/null); do
      _bytes=$(lsblk -bn -o SIZE -d "$_d" 2>/dev/null || echo 0)
      _mib=$((_bytes / 1048576))
      if test "$_mib" -lt "$MIN_DISK_MIB"; then continue; fi
      _live=no
      for _cand in /mnt/cdrom /run/live /run/archiso/bootmnt; do
        if findmnt -n -o SOURCE "$_cand" 2>/dev/null | grep -q "^$_d"; then _live=yes; fi
      done
      if test "$_live" = yes; then continue; fi
      _i=$((_i + 1))
      _model=$(lsblk -dn -o MODEL "$_d" 2>/dev/null | sed 's/^ *//;s/ *$//')
      _size=$(lsblk -dn -o SIZE "$_d" 2>/dev/null | sed 's/^ *//')
      tui_say "  [${_i}] $_d  $_size  $_model"
      _list="$_list $_d"
    done
    if test "$_i" -eq 0; then
      tui_err "No suitable disk found (need >= ${MIN_DISK_MIB}MiB, live media hidden)."
      die "no suitable installation disk"
    fi
    tui_say ""
    _pick=$(tui_ask "  Choose disk [1-$_i]")
    case "$_pick" in ''|*[!0-9]*) tui_err "Enter a number 1-$_i."; sleep 1; continue;; esac
    if test "$_pick" -lt 1 -o "$_pick" -gt "$_i" 2>/dev/null; then tui_err "Out of range."; sleep 1; continue; fi
    _n=0; for _d in $_list; do _n=$((_n + 1)); if test "$_n" = "$_pick"; then DISK=$_d; fi; done
    break
  done
  # 5/5 destructive confirmation with summary.
  while true; do
    tui_header
    _dmib=$(($(lsblk -bn -o SIZE -d "$DISK" 2>/dev/null || echo 0) / 1048576))
    tui_say "  Step 5/5: confirm"
    tui_say ""
    tui_say "  Disk:      $DISK"
    tui_say "  Username:  $NEWUSER"
    tui_say "  Hostname:  $HOSTNAME"
    tui_say "  Timezone:  $TIMEZONE"
    tui_say ""
    tui_say "  This will ERASE everything on $DISK (${_dmib}MiB)."
    tui_say ""
    _yn=$(tui_ask "  Type INSTALL to proceed, or Cancel [Cancel]")
    if test "$_yn" = "INSTALL"; then CONFIRM=yes; break; fi
    tui_say "  Installation cancelled; no changes were made."
    exit 1
  done
  if test -z "${EMERGENCE_INSTALL_PASSWORD:-}" && test -n "${EMERGENCE_INSTALL_PASSWORD_TUI:-}"; then
    EMERGENCE_INSTALL_PASSWORD=$EMERGENCE_INSTALL_PASSWORD_TUI
    export EMERGENCE_INSTALL_PASSWORD
    EMERGENCE_INSTALL_PASSWORD_TUI=x; unset EMERGENCE_INSTALL_PASSWORD_TUI
  fi
  tui_header
  tui_say "  Installing ..."
  tui_say ""
fi

test -n "$DISK" || usage
test "$(id -u)" -eq 0 || die "run as root (e.g. with sudo)"
need sfdisk; need mkfs.vfat; need mkfs.ext4; need blkid; need lsblk
need tar; need grub-install; need grub-mkconfig; need systemd-machine-id-setup
need useradd; need chpasswd; need passwd; need udevadm

# Validate names before touching the disk.
case "$HOSTNAME" in
  *[!a-zA-Z0-9-]*|"") die "invalid hostname: $HOSTNAME" ;;
esac
case "$NEWUSER" in
  ""|root|emergence|greeter|greetd|*[^a-z0-9_-]*|-[a-z0-9_-]*|[0-9]*) die "invalid username: $NEWUSER (must not be root/emergence/greeter/greetd)" ;;
esac
test -f "/usr/share/zoneinfo/$TIMEZONE" || die "unknown timezone: $TIMEZONE"
test -b "$DISK" || die "not a block device: $DISK"

# Refuse targets that are obviously wrong.
if grep -Eq "^[^ ]+ $MNT( |/)" /proc/mounts; then
  die "$MNT is already in use; unmount a previous install first"
fi
for part in $(lsblk -ln -o PATH "$DISK" 2>/dev/null | tail -n +2); do
  if grep -Eq "^[^ ]+ $part " /proc/mounts || findmnt -n -o TARGET "$part" >/dev/null 2>&1; then
    test "$part" = "$DISK" && continue
    die "refusing: $part (on $DISK) is currently mounted"
  fi
done
# Refuse the device the live ISO itself booted from (best effort).
for cand in /mnt/cdrom /run/live /run/archiso/bootmnt; do
  if findmnt -n -o SOURCE "$cand" >/dev/null 2>&1; then
    live_src=$(findmnt -n -o SOURCE "$cand")
    case "$live_src" in
      "$DISK"*) die "refusing: $DISK provides the running live image ($cand on $live_src)" ;;
    esac
  fi
done

DISK_MIB=$(($(lsblk -bn -o SIZE -d "$DISK") / 1048576))
test "$DISK_MIB" -ge "$MIN_DISK_MIB" || die "$DISK is only ${DISK_MIB}MiB (need >= ${MIN_DISK_MIB}MiB)"

log "install started: disk=$DISK size_mib=$DISK_MIB hostname=$HOSTNAME user=$NEWUSER timezone=$TIMEZONE"
info "plan:"
info "  disk:     $DISK (${DISK_MIB}MiB) -- ALL DATA WILL BE DESTROYED"
info "  layout:   GPT: p1 ${ESP_SIZE_MIB}MiB ESP (FAT32), p2 rest root (ext4)"
info "  hostname: $HOSTNAME"
info "  user:     $NEWUSER (any live-session account is removed from the target)"
info "  timezone: $TIMEZONE"
info "  boot:     GRUB x86_64-efi (NVRAM entry + removable fallback)"
info "  log:      $LOG (detailed diagnostics; never contains passwords)"
lsblk "$DISK" >&2 || true
log "disk layout shown; waiting for explicit confirmation"
test "$CONFIRM" = yes || die "re-run with --yes to confirm destruction of $DISK"

# Password for the new user.
if test -n "${EMERGENCE_INSTALL_PASSWORD:-}"; then
  info "using password from EMERGENCE_INSTALL_PASSWORD"
  NEW_PASSWORD=$EMERGENCE_INSTALL_PASSWORD
else
  test -c /dev/tty || die "no terminal for password prompt; set EMERGENCE_INSTALL_PASSWORD"
  stty -echo < /dev/tty
  trap 'stty echo < /dev/tty' EXIT INT TERM
  printf 'password for %s: ' "$NEWUSER" > /dev/tty
  IFS= read -r NEW_PASSWORD < /dev/tty
  printf '\nrepeat password: ' > /dev/tty
  IFS= read -r NEW_PASSWORD2 < /dev/tty
  stty echo < /dev/tty
  trap - EXIT INT TERM
  printf '\n' > /dev/tty
  test -n "$NEW_PASSWORD" || die "empty password refused"
  test "$NEW_PASSWORD" = "$NEW_PASSWORD2" || die "passwords do not match"
fi

# Partition (sectors throughout: the only unit every sfdisk accepts; 2048 =
# 1MiB alignment, 1048576 sectors = 512MiB ESP). Types are full GPT GUIDs:
# sfdisk 2.42 rejects MBR codes like 83 on GPT labels.
stage "Preparing disk $DISK (GPT, 512MiB ESP + root)"
log "partitioning $DISK"
sfdisk --wipe always "$DISK" <<EOF
label: gpt
unit: sectors
start=2048, size=1048576, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
start=1050624, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4
EOF
# Wait for partition nodes with or without a running udev daemon (the
# installer also runs from minimal shells where udevadm has no daemon).
partx -u "$DISK" 2>/dev/null || true
udevadm settle 2>/dev/null || sleep 2
ESP=${DISK}1
ROOTP=${DISK}2
case "$DISK" in
  *[0-9]) ESP=${DISK}p1; ROOTP=${DISK}p2 ;; # /dev/nvme0n1, /dev/mmcblk0, ...
esac
for i in $(seq 1 15); do
  test -b "$ESP" && test -b "$ROOTP" && break
  partx -u "$DISK" 2>/dev/null || true
  sleep 2
done
test -b "$ESP" || die "EFI partition did not appear: $ESP"
test -b "$ROOTP" || die "root partition did not appear: $ROOTP"
log "partitions ready: ESP=$ESP ROOT=$ROOTP"

stage "Formatting filesystems (FAT32 ESP, ext4 root)"
mkfs.vfat -F 32 -n DATUM_EFI "$ESP"
mkfs.ext4 -q -L datum-root -F "$ROOTP"
log "filesystems created"

stage "Installing Emergence (copying live system)"
info "mounting target ..."
cleanup() {
  umount -R "$MNT" 2>/dev/null || true
}
trap 'cleanup' EXIT INT TERM
mkdir -p "$MNT"
mount "$ROOTP" "$MNT"
mkdir -p "$MNT/boot/efi"
mount "$ESP" "$MNT/boot/efi"

info "copying live system (this takes a few minutes) ..."
log "copy started"
# NOTE: no --xattrs/--acls. The live overlayfs does not support listing
# xattrs, so those flags only produce thousands of failing syscalls (and, in
# a VM without a serial reader, enough warning spam to stall the copy on
# backpressure). Modes, ownership and timestamps are preserved; the image
# carries no file capabilities that would be lost (setuid bits are modes).
tar -C / --one-file-system \
  --exclude=./dev/* --exclude=./proc/* --exclude=./sys/* \
  --exclude=./tmp/* --exclude=./run/* --exclude=./mnt/* --exclude=./media/* \
  --exclude=./lost+found \
  -cf - . | tar -C "$MNT" -xpf -
mkdir -p "$MNT/dev" "$MNT/proc" "$MNT/sys" "$MNT/run" "$MNT/tmp" "$MNT/mnt" "$MNT/media"
chmod 1777 "$MNT/tmp"

# fstab by UUID.
ROOT_UUID=$(blkid -s UUID -o value "$ROOTP")
ESP_UUID=$(blkid -s UUID -o value "$ESP")
cat > "$MNT/etc/fstab" <<EOF
# Datum Emergence installed system (written by $PROG).
UUID=$ROOT_UUID  /          ext4  defaults           0 1
UUID=$ESP_UUID   /boot/efi  vfat  defaults           0 2
tmpfs            /tmp       tmpfs nodev,nosuid       0 0
EOF

# Chroot scaffolding for target configuration.
mount --bind /dev "$MNT/dev"
mount --bind /dev/pts "$MNT/dev/pts"
mount -t proc none "$MNT/proc"
mount --bind /sys "$MNT/sys"
mount --bind /run "$MNT/run"
# Best-effort: absent on minimal boots (e.g. init=/bin/sh without
# NetworkManager); nothing during installation needs name resolution.
cp -f /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null || true

target() { chroot "$MNT" /bin/sh -c "$1"; }

stage "Configuring system (hostname, timezone, machine identity)"
log "copy finished; writing fstab and host identity"
info "configuring installed system ..."
printf '%s\n' "$HOSTNAME" > "$MNT/etc/hostname"
cat > "$MNT/etc/hosts" <<EOF
127.0.0.1  localhost
::1        localhost
127.0.1.1  $HOSTNAME.localdomain $HOSTNAME
EOF
# Fresh machine identity (never carry the live session's over).
rm -f "$MNT/etc/machine-id" "$MNT/var/lib/dbus/machine-id"
target "systemd-machine-id-setup"
log "machine-id regenerated"
stage "Creating user $NEWUSER (live-only identity removed from target)"
# Live-only account cleanup. Booting the live ISO runs datum-firstboot-live,
# which creates the account the user chose and records it in
# /etc/datum/live-user (persistent, so it is copied onto the target by the
# tar step above) and /run/datum-live-user (runtime only). That account must
# not survive on the target: the installed system gets exactly one permanent
# user, created below.
#
# userdel cannot do this removal: the live session currently runs as that
# UID, so userdel would refuse (and it could touch the live account DBs
# instead of the target's). The target databases are plain text and no live
# process depends on the target copies, so edit them directly.
LIVE_USER=""
for marker in /etc/datum/live-user /run/datum-live-user; do
  if test -f "$marker"; then
    u=$(tr -d '[:space:]' < "$marker" 2>/dev/null || true)
    if test -n "$u"; then
      if test -z "$LIVE_USER"; then
        LIVE_USER=$u
      elif test "$u" != "$LIVE_USER"; then
        die "conflicting live-user markers: '$LIVE_USER' vs '$u' in $marker"
      fi
    fi
  fi
done
case "$LIVE_USER" in
  ""|root|emergence|greeter|greetd|*[^a-z0-9_-]*|-[a-z0-9_-]*|[0-9]*)
    if test -n "$LIVE_USER"; then
      die "live-user marker names an unusable account: '$LIVE_USER'"
    fi ;;
esac
if test -n "$LIVE_USER" && test "$LIVE_USER" != "$NEWUSER"; then
  info "removing live-only user '$LIVE_USER' from target ..."
  for f in passwd shadow gshadow; do
    if test -f "$MNT/etc/$f"; then
      grep -v "^$LIVE_USER:" "$MNT/etc/$f" > "$MNT/etc/$f.tmp" || true
      cat "$MNT/etc/$f.tmp" > "$MNT/etc/$f"
      rm -f "$MNT/etc/$f.tmp"
    fi
  done
  if test -f "$MNT/etc/group"; then
    # Strip the user from supplementary member lists, then drop a group
    # literally named after the user if left memberless. The shared primary
    # group (users) is untouched. (Marker names match [a-z0-9_-]; GNU \b.)
    sed -i -e "s/\b$LIVE_USER\b//g" -e 's/,,*/,/g' -e 's/:,/:/' -e 's/,$//' "$MNT/etc/group"
    sed -i "/^$LIVE_USER:[^:]*:[0-9][0-9]*:$/d" "$MNT/etc/group"
  fi
  rm -rf "$MNT/home/$LIVE_USER" "$MNT/var/mail/$LIVE_USER" "$MNT/var/spool/mail/$LIVE_USER"
elif test -n "$LIVE_USER"; then
  info "live user '$LIVE_USER' matches the requested installed user; adopting the account ..."
fi
# The marker is live-only state and must never survive into the installed system.
rm -f "$MNT/etc/datum/live-user"
rmdir "$MNT/etc/datum" 2>/dev/null || true
# The image ships no preset human accounts, so any remaining UID >= 1000
# entry on the target (other than the requested user) is unexpected live
# state: refuse to guess instead of silently inheriting it. (65534/nobody
# is not a human account.)
STRAY_USERS=$(awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' "$MNT/etc/passwd" 2>/dev/null || true)
for stray in $STRAY_USERS; do
  if test "$stray" != "$NEWUSER"; then
    die "unexpected UID>=1000 account '$stray' on target (live state?); refusing to inherit it"
  fi
done
for g in wheel users audio video render input plugdev; do
  target "getent group $g >/dev/null || groupadd -r $g"
done
if target "id $NEWUSER >/dev/null 2>&1"; then
  # Only the adopted live account may already exist here (anything else died
  # in the stray check above). Keep its home, fix groups/shell/ownership,
  # and set the installed password below.
  info "using existing '$NEWUSER' account from live session ..."
  target "usermod -s /bin/bash -g users -G wheel,users,audio,video,render,input,plugdev $NEWUSER"
  target "chown -R $NEWUSER:users /home/$NEWUSER"
else
  target "useradd -m -s /bin/bash -G wheel,users,audio,video,render,input,plugdev $NEWUSER"
fi
printf '%s:%s\n' "$NEWUSER" "$NEW_PASSWORD" | target "chpasswd"
NEW_PASSWORD=x; unset NEW_PASSWORD
log "permanent user password set (value never logged)"
target "passwd -l root || true"
# Installed systems autologin the permanent user: the live image carries no
# [initial_session] section (firstboot creates the account before greetd
# starts), so append one for the installed user. tuigreet stays as the
# fallback greeter. Match the section header exactly: the live config
# contains a comment mentioning initial_session.
if grep -q '^\[initial_session\]' "$MNT/etc/greetd/config.toml"; then
  die "unexpected initial_session in target greetd config"
fi
cat >> "$MNT/etc/greetd/config.toml" <<EOF

[initial_session]
command = "dbus-run-session /usr/local/bin/start-datum"
user = "$NEWUSER"
EOF
# Timezone.
ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$MNT/etc/localtime"
log "timezone set to $TIMEZONE"

stage "Installing bootloader (GRUB UEFI + removable fallback)"
# Bootloader. The dist-kernel + dracut initramfs are already in /boot from the
# live image; just (re)install GRUB and generate the config on the target.
# The removable fallback (BOOTX64.EFI) is mandatory: it is what boots on
# firmware without a registered entry (many VMs, some boards). The NVRAM
# entry is best-effort so installs also succeed where efivars is unavailable.
test -e "$MNT"/boot/vmlinuz-* || die "no kernel in target /boot; refusing to leave an unbootable system"
target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck"
if ! target "grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=datum --recheck"; then
  info "NVRAM boot entry could not be registered; removable fallback installed"
fi
target "grub-mkconfig -o /boot/grub/grub.cfg"
# grub-mkconfig falls back to unstable device names (root=/dev/...) when it
# cannot resolve UUIDs (no udev, unusual topologies). Device names shift
# across boots (USB media added/removed), so enforce the UUID root that the
# installer already wrote to fstab.
if grep -Eq "^[[:space:]]*linux[[:space:]]" "$MNT/boot/grub/grub.cfg"; then
  sed -i -E '/^[[:space:]]*linux[[:space:]]/ s#root=[^ ]+#root=UUID='"$ROOT_UUID"'#' "$MNT/boot/grub/grub.cfg"
  grep -Eq "root=UUID=$ROOT_UUID" "$MNT/boot/grub/grub.cfg" || die "could not enforce UUID root in grub.cfg"
fi

# Installed system keeps the intended services (symlinks were copied over,
# but re-enable to be certain they resolve on the target). The live
# first-boot wizard must never run here: the installer created the permanent
# user instead, so its unit and script are removed from the target outright
# (disabling alone would leave live-only files behind).
stage "Configuring desktop session (greetd, NetworkManager, firstboot cleanup)"
target "systemctl enable NetworkManager.service greetd.service"
target "systemctl disable datum-firstboot-live.service"
rm -f "$MNT/etc/systemd/system/datum-firstboot-live.service" \
  "$MNT/usr/local/bin/datum-firstboot-live"

stage "Validating installation (target self-check before reboot)"
validate_target() {
  # $1 = mountpoint. Fails loudly instead of declaring success on a
  # half-written target. Mirrors the automated host-side checks in
  # scripts/test-install.sh so manual installs get the same guarantees.
  t=$1
  vfail=0
  vcheck() {
    desc=$1; shift
    if "$@" >/dev/null 2>&1; then
      log "target check PASS: $desc"
    else
      info "target check FAIL: $desc"
      log "target check FAIL: $desc"
      vfail=1
    fi
  }
  vcheck "target root exists" test -d "$t/etc"
  vcheck "EFI partition mounted" test -d "$t/boot/efi"
  vcheck "fstab UUID root" grep -Eq '^UUID=[^ ]+ +/ +ext4' "$t/etc/fstab"
  vcheck "fstab UUID ESP" grep -Eq '^UUID=[^ ]+ +/boot/efi +vfat' "$t/etc/fstab"
  vcheck "root UUID matches fstab" grep -q "UUID=$ROOT_UUID" "$t/etc/fstab"
  vcheck "ESP UUID matches fstab" grep -q "UUID=$ESP_UUID" "$t/etc/fstab"
  vcheck "machine-id present" test -s "$t/etc/machine-id"
  vcheck "hostname correct" grep -qx "$HOSTNAME" "$t/etc/hostname"
  vcheck "timezone link" test -L "$t/etc/localtime"
  vcheck "kernel present" ls "$t"/boot/vmlinuz-*
  vcheck "GRUB config present" test -f "$t/boot/grub/grub.cfg"
  vcheck "GRUB UUID root" grep -Eq "root=UUID=$ROOT_UUID" "$t/boot/grub/grub.cfg"
  vcheck "removable bootloader" test -f "$t/boot/efi/EFI/BOOT/BOOTX64.EFI"
  vcheck "greetd config present" test -f "$t/etc/greetd/config.toml"
  vcheck "installed autologin user" grep -q "user = \"$NEWUSER\"" "$t/etc/greetd/config.toml"
  vcheck "target user exists" grep -q "^$NEWUSER:" "$t/etc/passwd"
  vcheck "target home exists" test -d "$t/home/$NEWUSER"
  vcheck "desktop launcher present" test -x "$t/usr/local/bin/start-datum"
  vcheck "hyprland config present" test -f "$t/etc/skel/.config/hypr/hyprland.lua"
  vcheck "live marker removed" test "!" -e "$t/etc/datum/live-user"
  vcheck "live firstboot unit removed" test "!" -e "$t/etc/systemd/system/datum-firstboot-live.service"
  vcheck "live firstboot script removed" test "!" -e "$t/usr/local/bin/datum-firstboot-live"
  if test "$vfail" -ne 0; then
    die "target validation failed; see $LOG. The disk was written but is NOT declared good."
  fi
  log "target validation passed"
}
validate_target "$MNT"
log "install finished: user=$NEWUSER host=$HOSTNAME disk=$DISK"
# Leave a sanitized copy of the install log on the target for post-install
# diagnostics (it never contains passwords or hashes by construction).
mkdir -p "$MNT/var/log" 2>/dev/null || true
cp -f "$LOG" "$MNT/var/log/emergence-installer.log" 2>/dev/null || true

info "unmounting ..."
trap - EXIT INT TERM
umount -R "$MNT"
rmdir "$MNT" 2>/dev/null || true
if test -c /dev/tty && test "$GAVE_DISK" = no; then
  printf '\033[H\033[2J' > /dev/tty 2>/dev/null || true
  printf '%s\n' "" "  +------------------------------------------------+" "  |                DATUM  EMERGENCE                |" "  |              Installation complete             |" "  +------------------------------------------------+" "" "  Installed on $DISK (user $NEWUSER, host $HOSTNAME)." "  Remove the live ISO and boot from $DISK." "" > /dev/tty
fi
info "installed Datum Emergence on $DISK (user $NEWUSER, host $HOSTNAME)."
info "remove the live ISO and boot from $DISK."
if test "$REBOOT" = yes; then
  info "rebooting ..."
  reboot
fi
