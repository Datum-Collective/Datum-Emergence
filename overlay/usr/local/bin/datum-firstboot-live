#!/bin/sh
# datum-firstboot-live: interactive live-session user setup for Datum Emergence.
#
# Runs once per live boot as root on a text TTY, BEFORE greetd, and creates
# the real local account the user chose (there is no preset live password).
# On success it records the username in /run/datum-live-user (runtime,
# authoritative for the live session) and /etc/datum/live-user (persistent,
# so the installer can find and remove this live-only account from the
# target it copies), then starts greetd, which offers a normal tuigreet
# login for that account.
#
# Security properties:
# - passwords are read with echo disabled and never printed, logged, or
#   passed as process arguments (chpasswd receives them on stdin);
# - progress markers go to the journal, /dev/kmsg and (best effort)
#   /dev/ttyS0, never secrets;
# - the script loops until a valid account exists; it never continues to
#   greetd with a half-created account.
set -eu

TTY=/dev/tty
STATE_FILE=/run/datum-live-user
# Persistent copy of the live username. The installer copies the live
# filesystem (excluding /run), reads this file from the target, removes the
# live-only account there, then deletes the file. It must never survive
# into a finished installed system.
PERSISTENT_STATE_FILE=/etc/datum/live-user
MAX_NAME_LEN=32

kmsg() {
  printf '%s\n' "Datum firstboot: $*" > /dev/kmsg 2>/dev/null || true
  printf '%s\n' "Datum firstboot: $*" > /dev/ttyS0 2>/dev/null || true
}
say() { printf '%s\n' "$*" >&3 2>/dev/null || printf '%s\n' "$*"; }

# Hold the TTY open for the whole run. Reopening /dev/tty per prompt leaves
# windows where no process holds it and arriving keystrokes can be lost, so
# a single held fd both preserves input and proves the TTY is usable up
# front (abort loudly now rather than mid-setup).
if ! exec 3<> "$TTY" 2>/dev/null; then
  kmsg "fatal: cannot open $TTY"
  printf '%s\n' "datum-firstboot-live: cannot open $TTY" >&2
  exit 1
fi

# Username rules mirror datum-install, plus the greeter account and a length
# cap (the installer fails loudly on those instead; here we reprompt).
valid_username() {
  name=$1
  case "$name" in
    "") return 1 ;;
    root|emergence|greeter|greetd) return 1 ;;
  esac
  case "$name" in
    *[^a-z0-9_-]*|-[a-z0-9_-]*|[0-9]*) return 1 ;;
  esac
  if test "${#name}" -gt "$MAX_NAME_LEN"; then return 1; fi
  return 0
}

prompt() {
  # $1 = prompt text, $2 = hide input (yes/no). Echoes the answer on stdout.
  text=$1
  hide=${2:-no}
  printf '%s' "$text" >&3
  if test "$hide" = yes; then
    stty -echo <&3 2>/dev/null || true
  fi
  # A failed read (e.g. EOF on a dead TTY) yields empty input, which
  # validation rejects with a reprompt; it must never abort setup under
  # set -eu. Sleep on failure so a dead TTY retries calmly instead of
  # spinning the prompt loop at full speed.
  IFS= read -r answer <&3 || { answer=""; sleep 2; }
  if test "$hide" = yes; then
    stty echo <&3 2>/dev/null || true
    printf '\n' >&3
  fi
  printf '%s' "$answer"
}
# Restore echo if interrupted mid-password.
trap 'stty echo <&3 2>/dev/null || true' INT TERM

# Restart-after-success (should not normally happen): if a previous run
# already completed, hand off to greetd instead of prompting again.
if test -f "$STATE_FILE"; then
  DONE_USER=$(cat "$STATE_FILE" 2>/dev/null | tr -d '[:space:]')
  if test -n "$DONE_USER" && getent passwd "$DONE_USER" >/dev/null 2>&1; then
    kmsg "already complete for $DONE_USER; starting greetd"
    exec 3<&- 2>/dev/null || true
    systemctl --no-block start greetd.service
    exit 0
  fi
fi

kmsg "starting user setup"

# Take exclusive ownership of the visible VT before painting anything. The boot
# path is quiet (livecd/bootargs), but stale getty text or a racing status line
# can still linger; a VT switch + reset guarantees the TUI is the only thing
# on screen (Failure A). All painting goes through fd 3 (the held TTY).
chvt 1 2>/dev/null || true
printf '\033c' >&3 2>/dev/null || true

show_header() {
  # Monochrome, structured, Datum-branded firstboot screen. No debug output,
  # no raw shell interaction: just the product, the task, and the prompts.
  # Clear first so each loop iteration repaint owns the screen instead of
  # scrolling under leftover boot text.
  printf '\033[H\033[2J' >&3 2>/dev/null || true
  say ""
  say "  +------------------------------------------------+"
  say "  |                DATUM  EMERGENCE                |"
  say "  |                First boot setup                |"
  say "  +------------------------------------------------+"
  say ""
  say "  Create the local account used by the live desktop."
  say ""
}

show_error() {
  # $1 = message. Readable, immediate, recoverable: stay in the loop,
  # never drop to a shell.
  say ""
  say "  ! $1"
  say "  Please try again."
  say ""
}

while true; do
  show_header
  NEWUSER=$(prompt "  Username: " no)
  if ! valid_username "$NEWUSER"; then
    case "$NEWUSER" in
      "") reason="empty username" ;;
      root|emergence|greeter|greetd) reason="reserved username '$NEWUSER'" ;;
      *) reason="invalid username '$NEWUSER' (a-z, 0-9, _ and -; must not start with a digit or -; max $MAX_NAME_LEN chars)" ;;
    esac
    show_error "Invalid username ($reason)."
    kmsg "invalid username rejected"
    continue
  fi
  if getent passwd "$NEWUSER" >/dev/null 2>&1; then
    show_error "The name '$NEWUSER' is already taken on this system."
    kmsg "username already exists"
    continue
  fi
  kmsg "username accepted: $NEWUSER"
  NEW_PASSWORD=$(prompt "  Password: " yes)
  NEW_PASSWORD2=$(prompt "  Confirm password: " yes)
  if test -z "$NEW_PASSWORD"; then
    show_error "Empty password rejected."
    kmsg "empty password rejected"
    NEW_PASSWORD=x; NEW_PASSWORD2=x; unset NEW_PASSWORD NEW_PASSWORD2
    continue
  fi
  if test "$NEW_PASSWORD" != "$NEW_PASSWORD2"; then
    show_error "Passwords do not match."
    kmsg "password mismatch"
    NEW_PASSWORD=x; NEW_PASSWORD2=x; unset NEW_PASSWORD NEW_PASSWORD2
    continue
  fi
  NEW_PASSWORD2=x; unset NEW_PASSWORD2
  say ""
  say "  Creating user '$NEWUSER' ..."
  kmsg "creating user $NEWUSER"
  # Same desktop group set the live session has always used (primary group
  # users, as before); only groups present in the target are assigned.
  EXTRA_GROUPS=""
  for g in wheel audio video render input plugdev cdrom; do
    if getent group "$g" >/dev/null 2>&1; then
      if test -z "$EXTRA_GROUPS"; then
        EXTRA_GROUPS=$g
      else
        EXTRA_GROUPS="$EXTRA_GROUPS,$g"
      fi
    fi
  done
  set -- -m -g users -s /bin/bash -c 'Datum Emergence live user'
  if test -n "$EXTRA_GROUPS"; then
    set -- "$@" -G "$EXTRA_GROUPS"
  fi
  if useradd "$@" "$NEWUSER" \
      && printf '%s:%s\n' "$NEWUSER" "$NEW_PASSWORD" | chpasswd; then
    NEW_PASSWORD=x; unset NEW_PASSWORD
    printf '%s\n' "$NEWUSER" > "$STATE_FILE"
    chmod 644 "$STATE_FILE"
    # Persistent marker for the installer (see header). Written only after
    # the account and its password exist, so a partial setup never leaves
    # a marker pointing at an unusable account.
    mkdir -p "$(dirname "$PERSISTENT_STATE_FILE")"
    printf '%s\n' "$NEWUSER" > "$PERSISTENT_STATE_FILE"
    chmod 644 "$PERSISTENT_STATE_FILE"
    say ""
    say "  +------------------------------------------------+"
    say "  |  Setup complete. Welcome to Datum Emergence.   |"
    say "  +------------------------------------------------+"
    say ""
    say "  Starting login ..."
    kmsg "setup complete for $NEWUSER"
    trap - INT TERM
    exec 3<&- 2>/dev/null || true
    # Leave tty1 blank for the greetd handoff: tuigreet repaints the VT, and
    # any leftover form text behind it reads as a broken login screen.
    printf '\033c' > /dev/tty1 2>/dev/null || true
    # --no-block: this unit is ordered Before=greetd.service while still
    # running, so a blocking start could deadlock waiting on ourselves.
    kmsg "starting greetd"
    systemctl --no-block start greetd.service
    exit 0
  fi
  NEW_PASSWORD=x; unset NEW_PASSWORD
  show_error "User creation failed unexpectedly."
  kmsg "user creation failed"
done
